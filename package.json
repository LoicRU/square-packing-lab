{
  "name": "square-packing-lab",
  "version": "1.0.0",
  "description": "Square Packing Lab — plateforme interactive de simulation du Square Packing Problem (Circle→Square, MaxRects, Guillotine, Skyline, recuit, forces).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node scripts/bench.mjs",
    "e2e": "node scripts/e2e.mjs",
    "check": "vitest run && vite build",
    "server": "node server/index.js",
    "test:server": "vitest run tests/server.test.js",
    "bench:parallel": "node scripts/bench-parallel.mjs",
    "bench:strips": "node scripts/bench-strips.mjs",
    "bench:fixed": "node scripts/bench-fixed.mjs",
    "build:prod": "vite build && node scripts/set-domain.mjs",
    "audit:a11y": "node scripts/audit-site.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
