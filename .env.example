# Parallel Packing Lab — configuration serveur (voir docs/PARALLEL.md §Configuration)
PPL_HOST=127.0.0.1        # 0.0.0.0 en production (alors PPL_TOKEN est obligatoire)
PPL_PORT=8787
PPL_TOKEN=                # secret long et aléatoire : openssl rand -hex 32
PPL_DB=data/ppl.sqlite    # fichier SQLite (à sauvegarder)
PPL_MAX_WORKERS=0         # 0 = automatique (cœurs, charge, mémoire)
PPL_MAX_RUNNING=0         # nombre max de recherches simultanées (0 = défaut)
PPL_WORKER_MB=0           # mémoire estimée par worker (0 = défaut 120)
PPL_ORIGIN=               # origine autorisée CORS si le front est hébergé ailleurs
PPL_STATIC=dist           # dossier du front servi par le serveur
PPL_AUTORESUME=1          # reprendre les recherches actives au redémarrage
PPL_TRUST_PROXY=0      # 1 derrière un reverse proxy de confiance : la limite de débit utilise X-Forwarded-For
PPL_HOSTS=             # noms d'hôte acceptés en plus de localhost (anti DNS-rebinding), ex. packing.example.com
PPL_HSTS=0             # 1 pour émettre Strict-Transport-Security (si servi en HTTPS)
